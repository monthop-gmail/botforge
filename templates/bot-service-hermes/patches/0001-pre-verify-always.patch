+def pre_verify_always(config: Optional[dict[str, Any]] = None) -> bool:
+    """Whether ``pre_verify`` may fire on turns that edited no files.
+
+    Default ``False`` keeps the historical scope (code-editing turns only).
+    Set ``agent.pre_verify_always: true`` when a hook implements a
+    non-filesystem finalization policy — e.g. a job runner that must not let a
+    turn end while work it accepted this execution is still unfinished. The
+    hook still receives ``changed_paths`` and can return ``None`` immediately
+    when it only cares about code edits, so enabling this costs nothing for
+    hooks that do not opt in.
+    """
+    return is_truthy_value(_agent_cfg(config).get("pre_verify_always", False), default=False)
