node_modules/

# Claude Code
.claude/
# config ของ MCP ระดับโปรเจกต์ — เป็นของเครื่องคนทำ ไม่ใช่ของที่ repo ส่งมอบ
# (หลักเดียวกับ .claude/ ที่ตัดสินไว้แล้ว)
.mcp.json

