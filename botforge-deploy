#!/usr/bin/env bash
set -euo pipefail

# --- Botforge Deploy CLI ---
# Manage deployment of all LINE Bot projects

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECTS_DIR="${PROJECTS_DIR:-$SCRIPT_DIR/projects}"
. "$SCRIPT_DIR/lib/secret.sh"
CONFIG_FILE="${CONFIG_FILE:-$SCRIPT_DIR/.botforge-deploy.env}"

# Default domain suffix
DEFAULT_DOMAIN_SUFFIX="sumana.org"

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# --- Helpers ---
print_header() {
    echo ""
    echo -e "${CYAN}${BOLD}Botforge Deploy — Multi-Bot Manager${NC}"
    echo -e "${CYAN}────────────────────────────────────${NC}"
    echo ""
}

print_success() { echo -e "${GREEN}$1${NC}"; }
print_error()   { echo -e "${RED}$1${NC}"; }
print_warn()    { echo -e "${YELLOW}$1${NC}"; }

# Get list of all project names
get_projects() {
    if [[ ! -d "$PROJECTS_DIR" ]]; then
        return
    fi
    for dir in "$PROJECTS_DIR"/*/; do
        if [[ -f "$dir/bot-service/docker-compose.yml" ]]; then
            basename "$dir"
        fi
    done
}

# Resolve target projects: "all" or specific name(s)
resolve_targets() {
    local target="${1:-}"
    if [[ -z "$target" || "$target" == "all" ]]; then
        get_projects
    else
        # Validate project exists
        if [[ ! -f "$PROJECTS_DIR/$target/bot-service/docker-compose.yml" ]]; then
            print_error "Project '$target' not found or has no docker-compose.yml"
            exit 1
        fi
        echo "$target"
    fi
}

# Detect engine type for a project
detect_engine() {
    local name="$1"
    local dir="$PROJECTS_DIR/$name/bot-service"
    # V2 ประกาศตัวเองด้วย botforge.yaml — ไม่มีโค้ดให้ sniff เพราะโค้ดอยู่ใน image
    if [[ -f "$dir/botforge.yaml" ]]; then
        local rt
        rt=$(grep -oE '^runtime:[[:space:]]*"?[a-z-]+' "$dir/botforge.yaml" 2>/dev/null | grep -oE '[a-z-]+$')
        echo "v2:${rt:-unknown}"
    elif [[ -f "$dir/server/api.py" ]]; then
        echo "adkcode"
    elif [[ -f "$dir/server/go.mod" ]]; then
        echo "gocode"
    elif [[ -f "$dir/opencode.json" ]]; then
        echo "opencode"
    elif grep -q "GEMINI_MODEL" "$dir/docker-compose.yml" 2>/dev/null; then
        echo "gemini-cli"
    elif grep -q "QWEN_MODEL" "$dir/docker-compose.yml" 2>/dev/null; then
        echo "qwen-code"
    elif grep -q "CODEX_APPSERVER_PORT" "$dir/docker-compose.yml" 2>/dev/null; then
        echo "codex-appserver"
    elif grep -q "CODEX_MODEL" "$dir/docker-compose.yml" 2>/dev/null; then
        echo "codex"
    elif grep -q "COPILOT_MODEL" "$dir/docker-compose.yml" 2>/dev/null; then
        echo "copilot-cli"
    elif [[ -d "$dir/server" ]]; then
        echo "claude-code"
    else
        echo "unknown"
    fi
}

# Run docker compose in a project's bot-service directory
dc() {
    local name="$1"
    shift
    local dir="$PROJECTS_DIR/$name/bot-service"
    docker compose -f "$dir/docker-compose.yml" --project-directory "$dir" --project-name "$name" "$@"
}

# --- Command: up ---
cmd_up() {
    local target="${1:-all}"
    local build_flag="${2:-}"
    print_header

    local projects
    projects=$(resolve_targets "$target")

    for name in $projects; do
        local engine
        engine=$(detect_engine "$name")
        echo -ne "  ${BOLD}$name${NC} ${DIM}($engine)${NC} — starting... "
        if [[ "$build_flag" == "--build" ]]; then
            dc "$name" up -d --build 2>/dev/null && print_success "ok" || print_error "FAILED"
        else
            dc "$name" up -d 2>/dev/null && print_success "ok" || print_error "FAILED"
        fi
    done
    echo ""
}

# --- Command: down ---
cmd_down() {
    local target="${1:-all}"
    print_header

    local projects
    projects=$(resolve_targets "$target")

    for name in $projects; do
        echo -ne "  ${BOLD}$name${NC} — stopping... "
        dc "$name" down 2>/dev/null && print_success "ok" || print_error "FAILED"
    done
    echo ""
}

# --- Command: restart ---
cmd_restart() {
    local target="${1:-all}"
    print_header

    local projects
    projects=$(resolve_targets "$target")

    for name in $projects; do
        local engine
        engine=$(detect_engine "$name")
        echo -ne "  ${BOLD}$name${NC} ${DIM}($engine)${NC} — restarting... "
        dc "$name" restart 2>/dev/null && print_success "ok" || print_error "FAILED"
    done
    echo ""
}

# --- Command: rebuild ---
cmd_rebuild() {
    local target="${1:-all}"
    local service="${2:-}"
    print_header

    local projects
    projects=$(resolve_targets "$target")

    for name in $projects; do
        local engine
        engine=$(detect_engine "$name")
        if [[ -n "$service" ]]; then
            echo -ne "  ${BOLD}$name${NC} ${DIM}($engine)${NC} — rebuilding $service... "
            dc "$name" up -d --build "$service" 2>/dev/null && print_success "ok" || print_error "FAILED"
        else
            echo -ne "  ${BOLD}$name${NC} ${DIM}($engine)${NC} — rebuilding all... "
            dc "$name" up -d --build 2>/dev/null && print_success "ok" || print_error "FAILED"
        fi
    done
    echo ""
}

# --- Command: status ---
cmd_status() {
    local target="${1:-all}"
    print_header

    local projects
    projects=$(resolve_targets "$target")

    printf "  ${BOLD}%-25s %-12s %-10s %-10s %-10s${NC}\n" "PROJECT" "ENGINE" "SERVER" "BOT" "TUNNEL"
    echo "  ─────────────────────────────────────────────────────────────────────"

    for name in $projects; do
        local engine
        engine=$(detect_engine "$name")

        # Get container statuses
        local containers
        containers=$(dc "$name" ps --format json 2>/dev/null || echo "")

        local server_status="down"
        local bot_status="down"
        local tunnel_status="down"

        if [[ -n "$containers" ]]; then
            # Parse each line of JSON output
            while IFS= read -r line; do
                if [[ -z "$line" ]]; then continue; fi
                local svc state
                svc=$(echo "$line" | python3 -c "import sys,json; print(json.load(sys.stdin).get('Service',''))" 2>/dev/null || echo "")
                state=$(echo "$line" | python3 -c "import sys,json; print(json.load(sys.stdin).get('State',''))" 2>/dev/null || echo "")

                case "$svc" in
                    opencode|server) server_status="$state" ;;
                    line-bot)        bot_status="$state" ;;
                    cloudflared)     tunnel_status="$state" ;;
                esac
            done <<< "$containers"
        fi

        # Color the statuses
        local s_color b_color t_color
        [[ "$server_status" == "running" ]] && s_color="$GREEN" || s_color="$RED"
        [[ "$bot_status" == "running" ]]    && b_color="$GREEN" || b_color="$RED"
        [[ "$tunnel_status" == "running" ]] && t_color="$GREEN" || t_color="$RED"

        printf "  %-25s %-12s ${s_color}%-10s${NC} ${b_color}%-10s${NC} ${t_color}%-10s${NC}\n" \
            "$name" "$engine" "$server_status" "$bot_status" "$tunnel_status"
    done
    echo ""
}

# --- Command: logs ---
cmd_logs() {
    local target="${1:-}"
    local service="${2:-}"
    local lines="${3:-30}"

    if [[ -z "$target" ]]; then
        print_error "Usage: botforge-deploy logs <project> [service] [lines]"
        echo "  Services: server|line-bot|cloudflared (default: all)"
        exit 1
    fi

    # Validate project
    if [[ ! -f "$PROJECTS_DIR/$target/bot-service/docker-compose.yml" ]]; then
        print_error "Project '$target' not found"
        exit 1
    fi

    if [[ -n "$service" ]]; then
        dc "$target" logs --tail "$lines" "$service"
    else
        dc "$target" logs --tail "$lines"
    fi
}

# --- Command: ps ---
cmd_ps() {
    local target="${1:-all}"
    print_header

    local projects
    projects=$(resolve_targets "$target")

    for name in $projects; do
        echo -e "  ${BOLD}$name${NC}"
        dc "$name" ps 2>/dev/null | sed 's/^/    /'
        echo ""
    done
}

# --- Command: pull ---
cmd_pull() {
    local target="${1:-all}"
    print_header

    local projects
    projects=$(resolve_targets "$target")

    for name in $projects; do
        echo -e "  ${BOLD}$name${NC} — pulling images..."
        dc "$name" pull 2>/dev/null | sed 's/^/    /'
        echo ""
    done
}

# ==============================================================================
# Cloudflare Tunnel Management (via API)
# ==============================================================================

CF_API="https://api.cloudflare.com/client/v4"

# Load Cloudflare credentials from config file
load_cf_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        print_error "Config not found. Run: ./botforge-deploy tunnel init"
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"

    if [[ -z "${CF_API_TOKEN:-}" || -z "${CF_ACCOUNT_ID:-}" || -z "${CF_ZONE_ID:-}" ]]; then
        print_error "Missing CF_API_TOKEN, CF_ACCOUNT_ID, or CF_ZONE_ID in $CONFIG_FILE"
        exit 1
    fi
}

# Cloudflare API call helper
cf_api() {
    local method="$1"
    local endpoint="$2"
    local data="${3:-}"

    local args=(-s -X "$method" -H "Authorization: Bearer $CF_API_TOKEN" -H "Content-Type: application/json")
    if [[ -n "$data" ]]; then
        args+=(-d "$data")
    fi
    curl "${args[@]}" "${CF_API}${endpoint}"
}

# --- tunnel init: configure Cloudflare credentials ---
cmd_tunnel_init() {
    print_header
    echo -e "  ${BOLD}Cloudflare Tunnel — Initial Setup${NC}"
    echo ""
    echo "  Create an API Token at: https://dash.cloudflare.com/profile/api-tokens"
    echo "  Required permissions:"
    echo "    - Account > Cloudflare Tunnel > Edit"
    echo "    - Zone > DNS > Edit"
    echo ""

    read -rp "  Cloudflare API Token: " cf_token
    if [[ -z "$cf_token" ]]; then
        print_error "API Token is required"
        exit 1
    fi

    # Verify token and get account info
    echo -n "  Verifying token... "
    local verify
    verify=$(curl -s -H "Authorization: Bearer $cf_token" "${CF_API}/user/tokens/verify")
    local status
    status=$(echo "$verify" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',False))" 2>/dev/null)

    if [[ "$status" != "True" ]]; then
        print_error "FAILED"
        echo "  Token verification failed. Check your token and try again."
        exit 1
    fi
    print_success "ok"

    # Get account ID
    echo -n "  Getting account info... "
    local accounts
    accounts=$(curl -s -H "Authorization: Bearer $cf_token" "${CF_API}/accounts?per_page=1")
    local account_id account_name
    account_id=$(echo "$accounts" | python3 -c "import sys,json; r=json.load(sys.stdin)['result']; print(r[0]['id'])" 2>/dev/null)
    account_name=$(echo "$accounts" | python3 -c "import sys,json; r=json.load(sys.stdin)['result']; print(r[0]['name'])" 2>/dev/null)

    if [[ -z "$account_id" ]]; then
        print_error "FAILED"
        echo "  Could not get account info"
        exit 1
    fi
    print_success "ok ($account_name)"

    # Get zone ID for domain
    read -rp "  Domain [$DEFAULT_DOMAIN_SUFFIX]: " domain
    domain="${domain:-$DEFAULT_DOMAIN_SUFFIX}"

    echo -n "  Getting zone info for $domain... "
    local zones
    zones=$(curl -s -H "Authorization: Bearer $cf_token" "${CF_API}/zones?name=$domain")
    local zone_id
    zone_id=$(echo "$zones" | python3 -c "import sys,json; r=json.load(sys.stdin)['result']; print(r[0]['id'])" 2>/dev/null)

    if [[ -z "$zone_id" ]]; then
        print_error "FAILED"
        echo "  Zone '$domain' not found in your Cloudflare account"
        exit 1
    fi
    print_success "ok"

    # Save config
    cat > "$CONFIG_FILE" <<EOF
# Botforge Deploy — Cloudflare Config
# Generated: $(date -Iseconds)
CF_API_TOKEN=$cf_token
CF_ACCOUNT_ID=$account_id
CF_ZONE_ID=$zone_id
CF_DOMAIN=$domain
EOF
    chmod 600 "$CONFIG_FILE"

    echo ""
    print_success "  Config saved to $CONFIG_FILE"
    echo ""
    echo "  Account: $account_name ($account_id)"
    echo "  Zone:    $domain ($zone_id)"
    echo ""
    echo -e "  ${BOLD}Next:${NC} ./botforge-deploy tunnel setup <project>"
    echo ""
}

# Get server port for an engine type
get_server_port() {
    local engine="${1#v2:}"          # v2:adkcode → adkcode
    case "$engine" in
        adkcode) echo "8000" ;;
        *)       echo "4096" ;;
    esac
}

# มี container ของ engine ให้เปิด UI ผ่าน tunnel ไหม
#
# ⚠️ ตัดเฉพาะ V2 เท่านั้น — V1 ทุก engine มี service `server` อยู่จริง
#    (codex/claude-code/copilot-cli ใช้ Hono ห่อ CLI ไว้ใน container `server`)
#    ถ้าตัด route ของ V1 ด้วยจะทำให้ bot ที่รันอยู่เสีย
#
# V2 มีเฉพาะ opencode กับ adkcode ที่มี container แยก
# ส่วน codex spawn app-server เป็น child process และ claude เรียก SDK ใน process เดียวกัน
engine_has_ui() {
    # ⚠️ adkcode ไม่เปิด route UI ให้โดยค่าเริ่มต้น — auth ของมันกันไม่ได้
    #    `server/api.py:85` ข้าม auth ให้ `/dev-ui*` เสมอ ส่วน API ที่ UI เรียก
    #    (`/list-apps`, `/run_sse`, `/apps/...`) อยู่ root level จึงโดน 401
    #    ตั้ง API_PASSWORD แล้วได้ผลคือ "หน้ายังเปิดโล่ง แต่ UI ใช้งานไม่ได้"
    #    ซึ่งแย่กว่าทั้งสองทาง — ตรวจกับ legal-services-server ตัวจริงเมื่อ 2026-08-24
    #
    #    ถ้าจะเปิดจริง ๆ ต้องกันที่ขอบ (Cloudflare Access / basicauth ที่ reverse proxy)
    #    แล้วค่อยตั้ง BOTFORGE_EXPOSE_ADKCODE_UI=1
    case "${1#v2:}" in
        adkcode) [[ "${BOTFORGE_EXPOSE_ADKCODE_UI:-0}" == "1" ]] && return 0 || return 1 ;;
    esac
    case "$1" in
        v2:opencode) return 0 ;;   # V2 ที่มี container ของ engine
        v2:*)        return 1 ;;   # V2 ที่เหลือไม่มี
        *)           return 0 ;;   # V1 ที่เหลือมี service server
    esac
}

# Helper: create or update a DNS CNAME record
_upsert_dns() {
    local hostname="$1"
    local dns_name="$2"
    local tunnel_id="$3"

    echo -n "    Creating DNS ($hostname)... "

    local dns_check
    dns_check=$(cf_api GET "/zones/$CF_ZONE_ID/dns_records?name=$hostname&type=CNAME")
    local dns_count
    dns_count=$(echo "$dns_check" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('result',[])))" 2>/dev/null)

    if [[ "$dns_count" -gt "0" ]]; then
        local dns_id
        dns_id=$(echo "$dns_check" | python3 -c "import sys,json; print(json.load(sys.stdin)['result'][0]['id'])" 2>/dev/null)
        local dns_update
        dns_update=$(cf_api PUT "/zones/$CF_ZONE_ID/dns_records/$dns_id" \
            "{\"type\":\"CNAME\",\"name\":\"$dns_name\",\"content\":\"$tunnel_id.cfargotunnel.com\",\"proxied\":true}")
        local dns_ok
        dns_ok=$(echo "$dns_update" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',False))" 2>/dev/null)
        [[ "$dns_ok" == "True" ]] && print_success "ok (updated)" || print_error "FAILED"
    else
        local dns_resp
        dns_resp=$(cf_api POST "/zones/$CF_ZONE_ID/dns_records" \
            "{\"type\":\"CNAME\",\"name\":\"$dns_name\",\"content\":\"$tunnel_id.cfargotunnel.com\",\"proxied\":true}")
        local dns_ok
        dns_ok=$(echo "$dns_resp" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',False))" 2>/dev/null)
        [[ "$dns_ok" == "True" ]] && print_success "ok (created)" || print_error "FAILED"
    fi
}

# Helper: delete a DNS CNAME record
_delete_dns() {
    local hostname="$1"

    echo -n "    Deleting DNS ($hostname)... "
    local dns_check
    dns_check=$(cf_api GET "/zones/$CF_ZONE_ID/dns_records?name=$hostname&type=CNAME")
    local dns_id
    dns_id=$(echo "$dns_check" | python3 -c "import sys,json; r=json.load(sys.stdin)['result']; print(r[0]['id'] if r else '')" 2>/dev/null)

    if [[ -z "$dns_id" ]]; then
        print_warn "not found"
    else
        local dns_del
        dns_del=$(cf_api DELETE "/zones/$CF_ZONE_ID/dns_records/$dns_id")
        local dns_ok
        dns_ok=$(echo "$dns_del" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',False))" 2>/dev/null)
        [[ "$dns_ok" == "True" ]] && print_success "ok" || print_error "FAILED"
    fi
}

# --- tunnel setup: create tunnel + DNS for a project ---
# Each project gets 2 hostnames:
#   {name}.domain           → http://{name}-line-bot:3000
#   {name}-server.domain    → http://{name}-server:{port}
cmd_tunnel_setup() {
    local target="${1:-}"
    print_header
    load_cf_config

    if [[ -z "$target" ]]; then
        print_error "Usage: ./botforge-deploy tunnel setup <project|all>"
        exit 1
    fi

    local projects
    projects=$(resolve_targets "$target")

    for name in $projects; do
        local env_file="$PROJECTS_DIR/$name/bot-service/.env"
        local engine
        engine=$(detect_engine "$name")
        local server_port
        server_port=$(get_server_port "$engine")

        local host_bot="${name}.${CF_DOMAIN}"
        local host_server="${name}-server.${CF_DOMAIN}"

        echo -e "  ${BOLD}$name${NC} ${DIM}($engine)${NC}"
        # route ของ UI มีเฉพาะ engine ที่มี container แยก
        # codex/claude ของ V2 ไม่มี — ใส่ route ไปก็ 502
        local ingress_rules="{\"hostname\":\"$host_bot\",\"service\":\"http://${name}-line-bot:3000\"},"
        echo "    $host_bot → http://${name}-line-bot:3000"
        if engine_has_ui "$engine"; then
            ingress_rules+="{\"hostname\":\"$host_server\",\"service\":\"http://${name}-server:${server_port}\"},"
            echo "    $host_server → http://${name}-server:${server_port}   (UI ของ engine)"
        else
            if [[ "${engine#v2:}" == "adkcode" ]]; then
                echo "    (ข้าม route UI — ADK dev UI กัน auth ไม่ได้ · BOTFORGE_EXPOSE_ADKCODE_UI=1 ถ้าจะเปิด)"
            else
                echo "    (ข้าม route UI — $engine ไม่มี container ของ engine แยก)"
            fi
        fi

        # ⚠️ จังหวะนี้คือจังหวะที่ UI ถูกเปิดออกอินเทอร์เน็ตจริง — เตือนถ้ายังไม่มีรหัส
        #    auth ของทุก engine เป็น opt-in และค่าว่าง = ไม่ติดตั้ง middleware เลย
        #    ที่นี่ **เตือนอย่างเดียว ไม่แก้ .env ให้** เพราะ bot อาจกำลังรันอยู่
        #    การเปลี่ยนรหัสใต้ตีนต้องเป็นการตัดสินใจของคนใช้ ไม่ใช่ผลข้างเคียงของ setup
        if engine_has_ui "$engine" && [[ -f "$env_file" ]]; then
            local gen skey cur
            [[ "$engine" == v2:* ]] && gen=v2 || gen=v1
            skey=$(secret_key_for "$gen" "${engine#v2:}")
            if [[ -n "$skey" ]]; then
                cur=$(grep -m1 -E "^${skey}=" "$env_file" 2>/dev/null | cut -d= -f2- | tr -d "\"' \r") || true
                if [[ -z "$cur" ]]; then
                    print_warn "    $skey ว่าง — UI จะเปิดให้ทุกคนที่รู้ hostname"
                    echo -e "    ${DIM}ตั้งใน $env_file แล้ว restart ก่อนเปิด tunnel${NC}"
                fi
            fi
        fi

        # Check if tunnel already exists
        local existing
        existing=$(cf_api GET "/accounts/$CF_ACCOUNT_ID/cfd_tunnel?name=$name&is_deleted=false")
        local existing_count
        existing_count=$(echo "$existing" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('result',[])))" 2>/dev/null)

        if [[ "$existing_count" -gt "0" ]]; then
            local existing_id
            existing_id=$(echo "$existing" | python3 -c "import sys,json; print(json.load(sys.stdin)['result'][0]['id'])" 2>/dev/null)
            print_warn "    Tunnel already exists (ID: $existing_id)"

            # Update ingress config with 2 hostnames
            echo -n "    Updating ingress... "
            local config_resp
            config_resp=$(cf_api PUT "/accounts/$CF_ACCOUNT_ID/cfd_tunnel/$existing_id/configurations" \
                "{\"config\":{\"ingress\":[${ingress_rules}{\"service\":\"http_status:404\"}]}}")
            local config_ok
            config_ok=$(echo "$config_resp" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',False))" 2>/dev/null)
            [[ "$config_ok" == "True" ]] && print_success "ok" || print_error "FAILED"

            # Upsert DNS records
            _upsert_dns "$host_bot" "$name" "$existing_id"
            engine_has_ui "$engine" && _upsert_dns "$host_server" "${name}-server" "$existing_id"

            # Get token and update .env
            echo -n "    Getting token... "
            local token_resp
            token_resp=$(cf_api GET "/accounts/$CF_ACCOUNT_ID/cfd_tunnel/$existing_id/token")
            local tunnel_token
            tunnel_token=$(echo "$token_resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['result'])" 2>/dev/null)
            if [[ -n "$tunnel_token" ]]; then
                print_success "ok"
                _update_env_token "$env_file" "$tunnel_token"
            else
                print_error "FAILED"
            fi
            echo ""
            continue
        fi

        # 1. Create tunnel
        echo -n "    Creating tunnel... "
        local tunnel_secret
        tunnel_secret=$(python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())")

        local create_resp
        create_resp=$(cf_api POST "/accounts/$CF_ACCOUNT_ID/cfd_tunnel" \
            "{\"name\":\"$name\",\"tunnel_secret\":\"$tunnel_secret\",\"config_src\":\"cloudflare\"}")

        local tunnel_id
        tunnel_id=$(echo "$create_resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['result']['id'])" 2>/dev/null)

        if [[ -z "$tunnel_id" ]]; then
            local err_msg
            err_msg=$(echo "$create_resp" | python3 -c "import sys,json; errs=json.load(sys.stdin).get('errors',[]); print(errs[0]['message'] if errs else 'unknown error')" 2>/dev/null)
            print_error "FAILED ($err_msg)"
            continue
        fi
        print_success "ok ($tunnel_id)"

        # 2. Configure tunnel ingress — 2 hostnames per project
        echo -n "    Configuring ingress... "
        local config_resp
        config_resp=$(cf_api PUT "/accounts/$CF_ACCOUNT_ID/cfd_tunnel/$tunnel_id/configurations" \
            "{\"config\":{\"ingress\":[${ingress_rules}{\"service\":\"http_status:404\"}]}}")

        local config_ok
        config_ok=$(echo "$config_resp" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',False))" 2>/dev/null)
        [[ "$config_ok" == "True" ]] && print_success "ok" || print_error "FAILED"

        # 3. Create DNS CNAME records (2 records)
        _upsert_dns "$host_bot" "$name" "$tunnel_id"
        engine_has_ui "$engine" && _upsert_dns "$host_server" "${name}-server" "$tunnel_id"

        # 4. Get tunnel token and save to .env
        echo -n "    Getting tunnel token... "
        local token_resp
        token_resp=$(cf_api GET "/accounts/$CF_ACCOUNT_ID/cfd_tunnel/$tunnel_id/token")
        local tunnel_token
        tunnel_token=$(echo "$token_resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['result'])" 2>/dev/null)

        if [[ -n "$tunnel_token" ]]; then
            print_success "ok"
            _update_env_token "$env_file" "$tunnel_token"
        else
            print_error "FAILED"
        fi

        echo ""
    done
}

# Helper: update CLOUDFLARE_TUNNEL_TOKEN in .env file
_update_env_token() {
    local env_file="$1"
    local token="$2"

    if [[ ! -f "$env_file" ]]; then
        # Copy from .env.example if available
        local example="${env_file}.example"
        if [[ -f "$example" ]]; then
            cp "$example" "$env_file"
        else
            # Create minimal .env
            echo "CLOUDFLARE_TUNNEL_TOKEN=" > "$env_file"
        fi
    fi

    if grep -q "^CLOUDFLARE_TUNNEL_TOKEN=" "$env_file"; then
        sed -i "s|^CLOUDFLARE_TUNNEL_TOKEN=.*|CLOUDFLARE_TUNNEL_TOKEN=$token|" "$env_file"
    else
        echo "CLOUDFLARE_TUNNEL_TOKEN=$token" >> "$env_file"
    fi
    echo -e "    ${DIM}Updated $env_file${NC}"
}

# --- tunnel list: show all tunnels ---
cmd_tunnel_list() {
    print_header
    load_cf_config

    echo -e "  ${BOLD}Cloudflare Tunnels${NC} (account: $CF_ACCOUNT_ID)"
    echo ""

    local tunnels
    tunnels=$(cf_api GET "/accounts/$CF_ACCOUNT_ID/cfd_tunnel?is_deleted=false&per_page=50")

    local count
    count=$(echo "$tunnels" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('result',[])))" 2>/dev/null)

    if [[ "$count" == "0" ]]; then
        echo "  (no tunnels)"
        echo ""
        return
    fi

    printf "  ${BOLD}%-25s %-38s %-12s %-25s${NC}\n" "NAME" "ID" "STATUS" "CONNECTIONS"
    echo "  ──────────────────────────────────────────────────────────────────────────────────────────"

    echo "$tunnels" | python3 -c "
import sys, json
data = json.load(sys.stdin)['result']
for t in data:
    name = t.get('name','')
    tid = t.get('id','')
    status = t.get('status','unknown')
    conns = len(t.get('connections',[]))
    conn_str = f'{conns} active' if conns > 0 else 'none'
    print(f'  {name:<25s} {tid:<38s} {status:<12s} {conn_str}')
" 2>/dev/null

    echo ""
}

# --- tunnel delete: delete tunnel + DNS for a project ---
cmd_tunnel_delete() {
    local target="${1:-}"
    print_header
    load_cf_config

    if [[ -z "$target" ]]; then
        print_error "Usage: ./botforge-deploy tunnel delete <project>"
        exit 1
    fi

    local hostname="${target}.${CF_DOMAIN}"
    echo -e "  Deleting tunnel for ${BOLD}$target${NC} ($hostname)"
    echo ""

    # Find tunnel
    local tunnels
    tunnels=$(cf_api GET "/accounts/$CF_ACCOUNT_ID/cfd_tunnel?name=$target&is_deleted=false")
    local tunnel_id
    tunnel_id=$(echo "$tunnels" | python3 -c "import sys,json; r=json.load(sys.stdin)['result']; print(r[0]['id'] if r else '')" 2>/dev/null)

    if [[ -z "$tunnel_id" ]]; then
        print_warn "  No tunnel found for '$target'"
    else
        # Check active connections
        local conns
        conns=$(echo "$tunnels" | python3 -c "import sys,json; print(len(json.load(sys.stdin)['result'][0].get('connections',[])))" 2>/dev/null)

        if [[ "$conns" -gt "0" ]]; then
            print_warn "  Tunnel has $conns active connections. Stop the container first?"
            read -rp "  Continue? [y/N]: " confirm
            if [[ "${confirm,,}" != "y" ]]; then
                echo "  Cancelled."
                return
            fi
            # Clean up connections
            echo -n "  Cleaning up connections... "
            cf_api DELETE "/accounts/$CF_ACCOUNT_ID/cfd_tunnel/$tunnel_id/connections" >/dev/null
            print_success "ok"
        fi

        echo -n "  Deleting tunnel... "
        local del_resp
        del_resp=$(cf_api DELETE "/accounts/$CF_ACCOUNT_ID/cfd_tunnel/$tunnel_id")
        local del_ok
        del_ok=$(echo "$del_resp" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',False))" 2>/dev/null)
        if [[ "$del_ok" == "True" ]]; then
            print_success "ok"
        else
            print_error "FAILED"
        fi
    fi

    # Delete DNS records (bot + server)
    _delete_dns "$hostname"
    _delete_dns "${target}-server.${CF_DOMAIN}"

    # Clear token from .env
    local env_file="$PROJECTS_DIR/$target/bot-service/.env"
    if [[ -f "$env_file" ]] && grep -q "^CLOUDFLARE_TUNNEL_TOKEN=" "$env_file"; then
        sed -i "s|^CLOUDFLARE_TUNNEL_TOKEN=.*|CLOUDFLARE_TUNNEL_TOKEN=|" "$env_file"
        echo -e "  ${DIM}Cleared token in $env_file${NC}"
    fi

    echo ""
}

# --- tunnel: main dispatcher ---
cmd_tunnel() {
    local subcmd="${1:-help}"
    shift || true

    case "$subcmd" in
        init)   cmd_tunnel_init "$@" ;;
        setup)  cmd_tunnel_setup "$@" ;;
        list|ls) cmd_tunnel_list "$@" ;;
        delete) cmd_tunnel_delete "$@" ;;
        help|--help|-h)
            print_header
            echo -e "  ${BOLD}Tunnel Commands:${NC}"
            echo ""
            echo -e "    ${BOLD}tunnel init${NC}                Setup Cloudflare API credentials"
            echo -e "    ${BOLD}tunnel setup${NC} <project|all> Create tunnel + DNS + save token to .env"
            echo -e "    ${BOLD}tunnel list${NC}                List all Cloudflare tunnels"
            echo -e "    ${BOLD}tunnel delete${NC} <project>    Delete tunnel + DNS record"
            echo ""
            echo "  Examples:"
            echo ""
            echo "    ./botforge-deploy tunnel init                # First-time setup"
            echo "    ./botforge-deploy tunnel setup dede-opencode # Create tunnel for one project"
            echo "    ./botforge-deploy tunnel setup all           # Create tunnels for all projects"
            echo "    ./botforge-deploy tunnel list                # Show all tunnels"
            echo "    ./botforge-deploy tunnel delete mtr-opencode # Delete tunnel"
            echo ""
            ;;
        *)
            print_error "Unknown tunnel command: $subcmd"
            cmd_tunnel help
            exit 1
            ;;
    esac
}

# --- Command: help ---
# =============================================================================
# domain — ย้ายทั้งระบบไป domain ใหม่
#
# domain ไม่ได้ฝังอยู่ในไฟล์ที่รันจริงเลย (compose/.env/container ไม่มี) มันอยู่ที่:
#   1. .botforge-deploy.env  → CF_ZONE_ID + CF_DOMAIN
#   2. DEFAULT_DOMAIN_SUFFIX ใน botforge และ botforge-deploy
#   3. Cloudflare: ingress ของ tunnel + DNS CNAME
#   4. LINE: webhook URL ของแต่ละ channel
#   5. เอกสารใน projects/ (ไม่กระทบการรัน)
#
# tunnel **ไม่ต้องสร้างใหม่** — token ผูกกับ account+tunnel ไม่ใช่ domain
# และ cloudflared ดึง ingress จาก Cloudflare เอง เปลี่ยนแล้วรับเองไม่ต้อง restart
# =============================================================================

LINE_API="https://api.line.me"

# อ่านค่าจาก .env โดยไม่พิมพ์ออกหน้าจอ
_env_get() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || return 1
    grep -m1 -E "^${key}=" "$file" 2>/dev/null | cut -d= -f2- | tr -d "\"'\r" | sed 's/[[:space:]]*$//'
}

# ดึงค่าจาก JSON ทาง stdin ตาม key ทีละชั้น — ไม่มี key คืนค่าว่าง
_json() {
    python3 -c '
import sys, json
try: d = json.load(sys.stdin)
except Exception: sys.exit(0)
for k in sys.argv[1:]:
    d = d.get(k) if isinstance(d, dict) else None
    if d is None: break
print("" if d is None else d)
' "$@"
}

# เรียก LINE Messaging API ด้วย token ของ project ที่กำหนด
#
# ⚠️ ส่ง token ผ่าน --config บน stdin ไม่ใช่ -H บน argv
#    argv ของ process มองเห็นได้จาก `ps` ของผู้ใช้อื่นบนเครื่องเดียวกัน
#    (cf_api ข้างบนยังใช้ -H อยู่ — คนละเรื่องกับงานนี้ ยังไม่แก้)
#
# endpoint ทั้งสามยืนยันจาก @line/bot-sdk ไม่ได้เดา:
#   PUT  /v2/bot/channel/webhook/endpoint  {"endpoint": "..."}
#   GET  /v2/bot/channel/webhook/endpoint  → {endpoint, active}
#   POST /v2/bot/channel/webhook/test      {"endpoint": "..."} → {success, ...}
_line_api() {
    local token="$1" method="$2" path="$3" data="${4:-}"
    local args=(-s -X "$method" -H "Content-Type: application/json")
    [[ -n "$data" ]] && args+=(-d "$data")
    printf 'header = "Authorization: Bearer %s"\n' "$token" \
        | curl --config - "${args[@]}" "${LINE_API}${path}"
}

_line_token_of() { _env_get "$PROJECTS_DIR/$1/bot-service/.env" LINE_CHANNEL_ACCESS_TOKEN; }

# แทนที่ข้อความในไฟล์แบบ tmp+mv
# ⚠️ ต้อง mv ไม่ใช่เขียนทับที่เดิม — สคริปต์นี้แก้ตัวเองด้วย และ bash อ่านไฟล์
#    ทีละส่วนระหว่างรัน เขียนทับ inode เดิมจะทำให้มันรันขยะต่อ
#    mv สร้าง inode ใหม่ ตัวที่กำลังรันยังถือ fd เก่าไว้จนจบ
_replace_in_file() {
    local file="$1" from="$2" to="$3" tmp
    # ⚠️ ถ้า $file เป็น symlink ต้องตามไปแก้ไฟล์จริง ไม่งั้น mv ข้างล่างจะเอาไฟล์ธรรมดา
    #    ไปทับตัว symlink ทิ้ง แล้วของจริงยังเป็นค่าเก่า (เจอมาแล้วกับ .botforge-deploy.env
    #    ตอน worktree v2 symlink ไปหา checkout หลัก)
    [[ -L "$file" ]] && file=$(readlink -f "$file")
    tmp=$(mktemp "${file}.XXXXXX") || return 1
    sed "s|${from//./\\.}|${to}|g" "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
    chmod --reference="$file" "$tmp" 2>/dev/null || true
    mv "$tmp" "$file"
}

cmd_domain_show() {
    load_cf_config
    print_header
    echo -e "  ${BOLD}Domain ปัจจุบัน:${NC} $CF_DOMAIN"
    echo ""

    echo -n "  zone ใน Cloudflare... "
    local z; z=$(cf_api GET "/zones/$CF_ZONE_ID")
    if [[ "$(echo "$z" | _json success)" == "True" ]]; then
        print_success "$(echo "$z" | _json result name) (status=$(echo "$z" | _json result status))"
    else
        print_error "เข้าถึงไม่ได้ — zone ถูกลบ หรือ CF_ZONE_ID ผิด"
    fi

    echo -n "  NS record... "
    # เครื่องที่ไม่มี dig/host ก็เยอะ — อย่าให้ทั้งคำสั่งตายเพราะเช็คเสริม
    local ns=""
    if command -v dig >/dev/null 2>&1; then
        ns=$(dig +short NS "$CF_DOMAIN" 2>/dev/null | tr '\n' ' ') || true
    elif command -v host >/dev/null 2>&1; then
        ns=$(host -t NS "$CF_DOMAIN" 2>/dev/null | awk '/name server/{print $NF}' | tr '\n' ' ') || true
    else
        print_warn "ไม่มี dig/host บนเครื่องนี้ — ข้าม"
        ns="__skip__"
    fi
    if [[ "$ns" != "__skip__" ]]; then
        [[ -n "${ns// /}" ]] && print_success "$ns" || print_error "ไม่มี — domain หลุดจาก DNS แล้ว"
    fi

    echo ""
    echo -e "  ${BOLD}webhook ที่ LINE ถืออยู่จริง${NC} ${DIM}(อ่านอย่างเดียว)${NC}"
    local name token resp
    for name in $(get_projects); do
        printf "    %-22s " "$name"
        token=$(_line_token_of "$name") || true
        if [[ -z "$token" ]]; then
            echo -e "${DIM}ไม่มี LINE token ใน .env${NC}"; continue
        fi
        resp=$(_line_api "$token" GET /v2/bot/channel/webhook/endpoint)
        local ep act msg
        ep=$(echo "$resp" | _json endpoint); act=$(echo "$resp" | _json active)
        msg=$(echo "$resp" | _json message)
        if [[ -n "$ep" ]]; then
            echo -e "$ep  ${DIM}active=$act${NC}"
        else
            print_error "${msg:-อ่านไม่ได้}"
        fi
    done
    echo ""
}

cmd_domain_change() {
    local new_domain="" dry=0 assume_yes=0 skip_line=0 skip_docs=0 skip_tunnel=0 force_line=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)     dry=1 ;;
            --yes|-y)      assume_yes=1 ;;
            --skip-line)   skip_line=1 ;;
            --force-line)  force_line=1 ;;
            --skip-docs)   skip_docs=1 ;;
            --skip-tunnel) skip_tunnel=1 ;;
            -*)            print_error "ไม่รู้จัก flag: $1"; return 1 ;;
            *)             new_domain="$1" ;;
        esac
        shift
    done

    if [[ -z "$new_domain" ]]; then
        print_error "ต้องระบุ domain ใหม่"
        echo "  ./botforge-deploy domain change <new-domain> [--dry-run]"
        return 1
    fi
    if [[ ! "$new_domain" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]]; then
        print_error "รูปแบบ domain ไม่ถูก: $new_domain"; return 1
    fi

    load_cf_config
    local old_domain="$CF_DOMAIN"
    if [[ "$new_domain" == "$old_domain" ]]; then
        print_error "domain ใหม่เหมือนเดิม ($old_domain) — ไม่มีอะไรต้องทำ"; return 1
    fi

    local _domain_mismatch=""

    print_header
    echo -e "  ${BOLD}เปลี่ยน domain${NC}  $old_domain ${DIM}→${NC} ${BOLD}$new_domain${NC}"
    [[ $dry -eq 1 ]] && echo -e "  ${YELLOW}DRY RUN — ไม่แก้อะไรทั้งนั้น${NC}"
    echo ""

    # --- preflight: zone ของ domain ใหม่ต้องมีอยู่ใน Cloudflare แล้ว ---
    # หา zone id ให้เอง ผู้ใช้ไม่ต้องไปคัดลอกจาก dashboard
    echo -n "  หา zone ของ $new_domain... "
    local zresp zcount new_zone_id zstatus
    zresp=$(cf_api GET "/zones?name=$new_domain")
    zcount=$(echo "$zresp" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('result') or []))" 2>/dev/null)
    if [[ "${zcount:-0}" -ne 1 ]]; then
        print_error "ไม่เจอ (หรือเจอมากกว่า 1)"
        echo ""
        echo "  ต้องเพิ่ม $new_domain เข้า Cloudflare ก่อน แล้วชี้ NS ที่ registrar"
        echo "  ขั้นตอนนี้ทำแทนไม่ได้ — https://dash.cloudflare.com → Add a site"
        return 1
    fi
    new_zone_id=$(echo "$zresp" | python3 -c "import sys,json; print(json.load(sys.stdin)['result'][0]['id'])" 2>/dev/null)
    zstatus=$(echo "$zresp" | python3 -c "import sys,json; print(json.load(sys.stdin)['result'][0].get('status',''))" 2>/dev/null)
    print_success "เจอแล้ว (status=$zstatus)"
    if [[ "$zstatus" != "active" ]]; then
        print_warn "    zone ยังไม่ active — NS ที่ registrar ยังไม่ชี้มาที่ Cloudflare"
        print_warn "    สร้าง record ได้ แต่ DNS จะยังไม่ตอบจนกว่า NS จะ propagate"
    fi

    # --- แผน ---
    echo ""
    echo -e "  ${BOLD}จะแตะอะไรบ้าง${NC}"
    echo "    1. $CONFIG_FILE                    CF_ZONE_ID + CF_DOMAIN"
    echo "    2. botforge, botforge-deploy       DEFAULT_DOMAIN_SUFFIX"
    [[ $skip_tunnel -eq 1 ]] && echo "    3. (ข้าม) tunnel ingress + DNS" \
                             || echo "    3. Cloudflare                      ingress + DNS ของทุก project"
    [[ $skip_line   -eq 1 ]] && echo "    4. (ข้าม) LINE webhook" \
                             || echo "    4. LINE                            webhook URL ของทุก channel"
    [[ $skip_docs   -eq 1 ]] && echo "    5. (ข้าม) เอกสาร" \
                             || echo "    5. projects/                       เอกสารที่อ้าง $old_domain"
    echo ""

    # ⚠️ อ่าน webhook ที่ LINE ถืออยู่จริงก่อน ไม่ใช่เดาจากชื่อ project
    #    เจอมาแล้วว่า legal-services ชี้ไป legal.thaidirection.com/line/webhook
    #    คนละ domain คนละ path — เขียนทับเป็น <name>.<new>/webhook คือทำ bot พัง
    local name token cur curhost
    echo -e "  ${BOLD}project${NC} ${DIM}(webhook ปัจจุบันอ่านจาก LINE จริง)${NC}"
    printf "    %-22s %-40s %s\n" "project" "webhook ใหม่" "หมายเหตุ"
    for name in $(get_projects); do
        token=$(_line_token_of "$name") || true
        if [[ -z "$token" ]]; then
            printf "    %-22s %-40s %s\n" "$name" "—" "ไม่มี LINE token · ข้าม"
            continue
        fi
        cur=$(_line_api "$token" GET /v2/bot/channel/webhook/endpoint | _json endpoint)
        curhost="${cur#https://}"; curhost="${curhost%%/*}"
        if [[ "$curhost" == "${name}.${old_domain}" ]]; then
            printf "    %-22s %-40s %s\n" "$name" "https://${name}.${new_domain}/webhook" "ตรงกับ domain เดิม"
        elif [[ -z "$cur" ]]; then
            printf "    %-22s %-40s %s\n" "$name" "https://${name}.${new_domain}/webhook" "ยังไม่เคยตั้ง"
        else
            _domain_mismatch+=" $name"
            printf "    %-22s %-40s %s\n" "$name" "$(if [[ $force_line -eq 1 ]]; then echo "https://${name}.${new_domain}/webhook"; else echo "— ไม่แตะ"; fi)" \
                "⚠️ ตอนนี้ชี้ $cur"
        fi
    done
    if [[ -n "${_domain_mismatch// /}" ]]; then
        echo ""
        if [[ $force_line -eq 1 ]]; then
            print_warn "    --force-line: จะเขียนทับ${_domain_mismatch} ด้วย"
        else
            print_warn "    ข้าม${_domain_mismatch} เพราะ webhook ไม่ได้อยู่บน $old_domain"
            echo -e "    ${DIM}ถ้าตั้งใจจะย้ายด้วย ใส่ --force-line${NC}"
        fi
    fi

    local doc_files doc_count=0
    doc_files=$(grep -rl "$old_domain" "$PROJECTS_DIR" --exclude-dir=.git --exclude-dir=node_modules --exclude='*.bak' 2>/dev/null || true)
    [[ -n "$doc_files" ]] && doc_count=$(echo "$doc_files" | wc -l)
    echo ""
    echo "    ไฟล์ใน projects/ ที่อ้าง $old_domain: $doc_count ไฟล์"

    if [[ $dry -eq 1 ]]; then
        echo ""
        echo -e "  ${YELLOW}จบ dry run — ยังไม่ได้แก้อะไร${NC}"
        echo "  รันจริง: ./botforge-deploy domain change $new_domain"
        return 0
    fi

    if [[ $assume_yes -ne 1 ]]; then
        echo ""
        read -rp "  ไปต่อ? [y/N]: " ok
        [[ "${ok,,}" == "y" ]] || { echo "  ยกเลิก"; return 0; }
    fi

    local stamp; stamp=$(date +%Y%m%d-%H%M%S)

    # --- 1. config ---
    echo ""
    echo -n "  1/5 $CONFIG_FILE... "
    cp -p "$CONFIG_FILE" "$CONFIG_FILE.bak-$stamp" && chmod 600 "$CONFIG_FILE.bak-$stamp"
    _replace_in_file "$CONFIG_FILE" "$CF_ZONE_ID" "$new_zone_id"
    _replace_in_file "$CONFIG_FILE" "CF_DOMAIN=$old_domain" "CF_DOMAIN=$new_domain"
    chmod 600 "$CONFIG_FILE"
    print_success "ok (สำรอง .bak-$stamp)"

    # ใช้ค่าใหม่ใน process นี้เลย ไม่งั้น cmd_tunnel_setup จะยังยิงไป zone เก่า
    CF_ZONE_ID="$new_zone_id"
    CF_DOMAIN="$new_domain"

    # --- 2. สคริปต์ ---
    echo -n "  2/5 DEFAULT_DOMAIN_SUFFIX... "
    local f n=0
    for f in "$SCRIPT_DIR/botforge" "$SCRIPT_DIR/botforge-deploy"; do
        [[ -f "$f" ]] || continue
        grep -q "DEFAULT_DOMAIN_SUFFIX=\"$old_domain\"" "$f" || continue
        _replace_in_file "$f" "DEFAULT_DOMAIN_SUFFIX=\"$old_domain\"" "DEFAULT_DOMAIN_SUFFIX=\"$new_domain\"" && n=$((n+1))
    done
    print_success "แก้ $n ไฟล์"

    # --- 3. tunnel ingress + DNS ---
    if [[ $skip_tunnel -eq 1 ]]; then
        echo "  3/5 tunnel... ข้าม"
    else
        echo "  3/5 tunnel ingress + DNS"
        cmd_tunnel_setup all
    fi

    # --- 4. LINE webhook ---
    if [[ $skip_line -eq 1 ]]; then
        echo "  4/5 LINE webhook... ข้าม"
    else
        echo ""
        echo "  4/5 LINE webhook"
        local url resp ok_set test_ok cur curhost
        for name in $(get_projects); do
            printf "    %-22s " "$name"
            token=$(_line_token_of "$name") || true
            [[ -z "$token" ]] && { echo -e "${DIM}ไม่มี token ข้าม${NC}"; continue; }

            cur=$(_line_api "$token" GET /v2/bot/channel/webhook/endpoint | _json endpoint)
            curhost="${cur#https://}"; curhost="${curhost%%/*}"
            if [[ -n "$cur" && "$curhost" != "${name}.${old_domain}" && $force_line -ne 1 ]]; then
                print_warn "ข้าม — ชี้ $cur (ไม่ใช่ $old_domain)"
                continue
            fi

            url="https://${name}.${new_domain}/webhook"
            resp=$(_line_api "$token" PUT /v2/bot/channel/webhook/endpoint "{\"endpoint\":\"$url\"}")
            # PUT สำเร็จ LINE คืน {} — ถือว่าพังเมื่อมี message กลับมา
            ok_set=$(echo "$resp" | _json message)
            if [[ -n "$ok_set" ]]; then
                print_error "ตั้งไม่ได้: $ok_set"
                continue
            fi
            # ยืนยันด้วยการให้ LINE ยิงจริง — บอกได้ว่า DNS+tunnel+bot พร้อมจริงไหม
            test_ok=$(_line_api "$token" POST /v2/bot/channel/webhook/test "{\"endpoint\":\"$url\"}" | _json success)
            if [[ "$test_ok" == "True" ]]; then
                print_success "ok — LINE ยิงทดสอบผ่าน"
            else
                print_warn "ตั้งแล้ว แต่ LINE ยิงทดสอบไม่ผ่าน (bot อาจยังไม่ขึ้น / DNS ยังไม่ propagate)"
            fi
        done
    fi

    # --- 5. เอกสาร ---
    if [[ $skip_docs -eq 1 ]]; then
        echo "  5/5 เอกสาร... ข้าม"
    else
        echo -n "  5/5 เอกสารใน projects/... "
        local c=0
        if [[ -n "$doc_files" ]]; then
            while IFS= read -r f; do
                [[ -n "$f" ]] || continue
                _replace_in_file "$f" "$old_domain" "$new_domain" && c=$((c+1))
            done <<< "$doc_files"
        fi
        print_success "แก้ $c ไฟล์"
    fi

    echo ""
    print_success "  เสร็จ — $old_domain → $new_domain"
    echo ""
    echo "  ตรวจต่อ:"
    echo "    ./botforge-deploy domain show          # webhook ที่ LINE ถืออยู่จริง"
    echo "    ./botforge-deploy tunnel list"
    echo ""
    echo -e "  ${DIM}ถอยกลับ config: cp $CONFIG_FILE.bak-$stamp $CONFIG_FILE${NC}"
    echo ""
}

cmd_domain() {
    local sub="${1:-show}"
    shift || true
    case "$sub" in
        show)   cmd_domain_show "$@" ;;
        change) cmd_domain_change "$@" ;;
        *)      print_error "domain: ไม่รู้จัก '$sub' (show|change)"; return 1 ;;
    esac
}

cmd_help() {
    print_header
    echo "  Usage:"
    echo ""
    echo "    ./botforge-deploy <command> [project] [options]"
    echo ""
    echo "  Commands:"
    echo ""
    echo -e "    ${BOLD}up${NC} [project|all] [--build]    Start services (default: all)"
    echo -e "    ${BOLD}down${NC} [project|all]             Stop services"
    echo -e "    ${BOLD}restart${NC} [project|all]          Restart services"
    echo -e "    ${BOLD}rebuild${NC} [project|all] [svc]    Rebuild & restart (optionally specific service)"
    echo -e "    ${BOLD}status${NC} [project|all]           Show container status"
    echo -e "    ${BOLD}logs${NC} <project> [svc] [lines]   Show logs (default: all services, 30 lines)"
    echo -e "    ${BOLD}ps${NC} [project|all]               Show running containers"
    echo -e "    ${BOLD}pull${NC} [project|all]             Pull latest images"
    echo -e "    ${BOLD}tunnel${NC} <init|setup|list|delete> Manage Cloudflare tunnels"
    echo -e "    ${BOLD}domain${NC} <show|change>          ย้ายทั้งระบบไป domain ใหม่"
    echo -e "    ${BOLD}help${NC}                           Show this help"
    echo ""
    echo "  Examples:"
    echo ""
    echo "    ./botforge-deploy status                   # Status of all bots"
    echo "    ./botforge-deploy up                       # Start all bots"
    echo "    ./botforge-deploy up all --build           # Build & start all"
    echo "    ./botforge-deploy up dede-opencode         # Start one bot"
    echo "    ./botforge-deploy down mtr-opencode        # Stop one bot"
    echo "    ./botforge-deploy rebuild hct-opencode     # Rebuild & restart"
    echo "    ./botforge-deploy rebuild dede-opencode line-bot  # Rebuild specific service"
    echo "    ./botforge-deploy logs cowork-claudecode   # View logs"
    echo "    ./botforge-deploy logs dede-opencode server 50  # Last 50 lines of server"
    echo "    ./botforge-deploy tunnel init                 # Setup Cloudflare credentials"
    echo "    ./botforge-deploy tunnel setup all            # Create tunnels for all bots"
    echo "    ./botforge-deploy domain show                 # domain + webhook ที่ LINE ถืออยู่จริง"
    echo "    ./botforge-deploy domain change new.com --dry-run   # ดูก่อนว่าจะแตะอะไร"
    echo "    ./botforge-deploy domain change new.com       # ย้ายจริง (ต้องเพิ่ม zone ใน CF ก่อน)"
    echo ""
    echo "  Projects:"
    echo ""
    local projects
    projects=$(get_projects)
    if [[ -z "$projects" ]]; then
        echo "    (none)"
    else
        for name in $projects; do
            local engine
            engine=$(detect_engine "$name")
            echo "    $name  ($engine)"
        done
    fi
    echo ""
}

# --- Main ---
main() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        up)       cmd_up "$@" ;;
        down)     cmd_down "$@" ;;
        restart)  cmd_restart "$@" ;;
        rebuild)  cmd_rebuild "$@" ;;
        status|st) cmd_status "$@" ;;
        logs)     cmd_logs "$@" ;;
        ps)       cmd_ps "$@" ;;
        pull)     cmd_pull "$@" ;;
        tunnel)   cmd_tunnel "$@" ;;
        domain)   cmd_domain "$@" ;;
        help|--help|-h) cmd_help ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
